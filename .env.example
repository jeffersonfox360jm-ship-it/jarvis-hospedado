# PIN que você digita para entrar (só você usa as suas chaves). Obrigatório em produção.
APP_PIN=
# Qualquer texto longo e aleatório (no Render é gerado sozinho). Pode reaproveitar o JWT_SECRET.
SESSION_SECRET=

# Chave da API do YouTube (YouTube Data API v3). Fica só no servidor.
YOUTUBE_API_KEY=
YOUTUBE_REGION=BR

# Conversa: preencha pelo menos um provedor (chave + modelo). Ordem de uso: Groq → OpenAI → Gemini.
GROQ_API_KEY=
MODEL_GROQ=
OPENAI_API_KEY=
MODEL_OPENAI=
GEMINI_API_KEY=
MODEL_GEMINI=

# Modelos de transcrição (opcional; já vêm com padrão)
TRANSCRIBE_MODEL_GROQ=whisper-large-v3-turbo
TRANSCRIBE_MODEL_OPENAI=whisper-1

PORT=3000
